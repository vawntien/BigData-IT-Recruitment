    "remove_content_tags": [
      "script",
      "style"
    ],
    "protected_regexes": [
      "(?:https?://|www\\.)[^\\s<>]+",
      "(?<!\\w)\\.net\\b",
      "\\bnode\\.js\\b",
      "\\basp\\.net\\b",
      "\\breact\\.js\\b",
      "\\bangular\\.js\\b",
      "\\bv?\\d+(?:\\.\\d+)+\\b",
      "\\b(?:e\\.g\\.|i\\.e\\.|U\\.S\\.|U\\.K\\.|Ph\\.D\\.|B\\.S\\.|M\\.S\\.|Inc\\.|Ltd\\.|etc\\.)"
    ],
    "sentence_boundary_regex": "[.!?;](?=\\s|$|[A-Z])",
    "structural_regex": "\\r\\n|[\\r\\n\\u2028\\u2029]|[•·●▪◦‣⁃]|(?m:^[ \\t]*(?:[-*]|\\d+[.)])(?=[ \\t]))",
    "adversative_regex": "\\b(?:but|however|yet|nevertheless)\\b",
    "long_description_policy": "retain_all_units_no_500_character_cutoff"
  },
