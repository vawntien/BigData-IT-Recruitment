      "null",
      "n/a",
      "na"
    ]
  },
  "matching": {
    "boundary": "unicode_word_plus_hash",
    "overlap": "longest_alias_first_no_implied_parent_skill",
    "context_radius_codepoints": 100,
    "technology_list_separator_regex": "^\\s*(?:[,/&|+]\\s*|(?:and|or|và|hoặc)\\s*)+$"
  },
  "parser": {
    "decode_entities": true,
    "block_tags": [
